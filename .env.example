# Copy to .env and adjust. All variables are documented in README.md.

# --- Prometheus (required) ---
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
PROMETHEUS_QUERY_TIMEOUT=30s
PROMETHEUS_MAX_DATA_POINTS=1000

# --- LLM (optional; chat is disabled when LLM_BASE_URL is empty) ---
# Any OpenAI-compatible endpoint: OpenAI, Ollama, vLLM, LM Studio, OpenRouter...
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=120s
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
# Vendor-specific request options as JSON, e.g. disable Qwen thinking on vLLM:
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
LLM_EXTRA_BODY=
LLM_MAX_TOOL_ITERATIONS=8

# --- Catalog ---
CATALOG_LLM_ENRICH=false
CATALOG_REBUILD_INTERVAL=24h
CATALOG_LABEL_SAMPLE_LIMIT=2000
CATALOG_CONCURRENCY=6

# --- Authentication (docs/auth.md) ---
# Unset = open instance. Set a password before exposing PromPilot beyond a private network.
AUTH_PASSWORD=
AUTH_API_TOKEN=
AUTH_SESSION_TTL=30d
AUTH_COOKIE_SECURE=false
# Signs sessions and encrypts stored project passwords; auto-generated into $DATA_DIR/secret.key when unset.
SECRET_KEY=

# --- Voice (docs/voice.md) ---
# browser = Web Speech API in the browser. openai = /audio/* endpoints (OpenAI, Speaches, Kokoro, LocalAI).
# gemini = audio via chat completions. elevenlabs = ElevenLabs Scribe / TTS.
STT_PROVIDER=browser
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
TTS_PROVIDER=browser
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
ELEVENLABS_API_KEY=

# --- Knowledge base (docs/knowledge.md) ---
# Directory of Markdown notes about your system; default is $DATA_DIR/knowledge
KNOWLEDGE_DIR=

# --- Runtime ---
DATA_DIR=/data
PORT=8080
LOG_LEVEL=info
