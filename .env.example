# Copy to .env and adjust. All variables are documented in README.md.

# --- Prometheus (required) ---
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
PROMETHEUS_QUERY_TIMEOUT=30s
PROMETHEUS_MAX_DATA_POINTS=1000

# --- LLM (optional; chat is disabled when LLM_BASE_URL is empty) ---
# Any OpenAI-compatible endpoint: OpenAI, Ollama, vLLM, LM Studio, OpenRouter...
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=60s

# --- Catalog ---
CATALOG_LLM_ENRICH=false
CATALOG_REBUILD_INTERVAL=24h

# --- Runtime ---
DATA_DIR=/data
PORT=8080
LOG_LEVEL=info
