{
  "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
  },
  "description": "",
  "fieldConfig": {
    "defaults": {
      "unit": "percentunit"
    },
    "overrides": []
  },
  "options": {
    "cellHeight": "sm",
    "footer": {
      "show": false
    },
    "showHeader": true
  },
  "targets": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "expr": "1 - node_filesystem_avail_bytes / node_filesystem_size_bytes",
      "format": "table",
      "instant": true,
      "legendFormat": "__auto",
      "range": false,
      "refId": "A"
    }
  ],
  "title": "Disk usage per mountpoint",
  "transformations": [
    {
      "id": "organize",
      "options": {
        "excludeByName": {
          "Time": true,
          "__name__": true,
          "instance": true,
          "job": true
        },
        "indexByName": {},
        "renameByName": {}
      }
    },
    {
      "id": "sortBy",
      "options": {
        "sort": [
          {
            "desc": true,
            "field": "Value"
          }
        ]
      }
    },
    {
      "id": "limit",
      "options": {
        "limitField": 20
      }
    }
  ],
  "type": "table"
}
